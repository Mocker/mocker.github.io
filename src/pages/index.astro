---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const selectedWork = (await getCollection('projects', ({ data }) => data.visibility !== 'hidden'))
  .sort((a, b) => a.data.order - b.data.order);

---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Senior Software Engineer · Software Architect</p>
      <h1 id="hero-title">Hi, I’m Ryan.</h1>
      <p class="hero-summary">
        Platform backend engineer at Earnest from 2019 to 2024 — first via Wizeline, then direct — where I worked on the
        monolith-to-microservices migration for services spanning the full user lifecycle. Currently building Anna, a
        persistent memory layer for AI assistants, and rebuilding PRISM, a Zero-Trust gateway for MCP traffic, on Cloudflare.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/resume">View resume</a>
        <a class="btn-secondary" href="/assets/Ryan_Guthrie_Resume.pdf" target="_blank">Resume PDF <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="mailto:ryan@ryanguthrie.com">ryan@ryanguthrie.com</a>
      </div>
      <div class="availability" aria-label="Location and work preference">
        <span>Eugene, Oregon</span>
        <span>Remote-first · Open to senior engineering and architecture roles</span>
      </div>
    </div>
  </section>


  <section id="work" class="section-shell container" aria-labelledby="work-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Current and recent work.</h2>
      </div>
      <p class="section-intro">
        Independent work since 2024. Employment history is in the career section below and on the resume page.
      </p>
    </div>

    <div class="projects-grid">
      {selectedWork.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.summary}
          tags={project.data.tags}
          kind={project.data.kind}
          status={project.data.status}
          timeframe={project.data.timeframe}
          liveUrl={project.data.liveUrl}
          githubUrl={project.data.githubUrl}
          evidence={project.data.evidence}
        />
      ))}
    </div>
  </section>

  <section id="career" class="section-shell career-section">
    <div class="container career-grid">
      <div>
        <p class="eyebrow">Career</p>
        <h2>From Linux infrastructure to senior product engineering.</h2>
      </div>
      <div class="career-copy">
        <p>
          At Earnest (2019–2024, first on Wizeline's Platform Team, then as a direct hire), I worked on the
          monolith-to-microservices migration; the services I owned touched every part of the user lifecycle. Before that,
          seven years as Senior Software Architect at Paybook (2013–2019), where I was the first engineer on the financial
          aggregation backbone, and more than a decade consulting across software development, infrastructure, security,
          and data systems.
        </p>
        <div class="career-actions">
          <a class="btn-primary" href="/resume">Explore career history</a>
          <a class="btn-secondary" href="https://www.linkedin.com/in/ryanguthrie/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell now-section" aria-labelledby="now-title">
    <div class="container">
      <p class="eyebrow">Now</p>
      <p class="now-copy" id="now-title">
        Building <a href="https://anna.gup.io" target="_blank" rel="noopener noreferrer">Anna</a> — now in private
        beta — rebuilding PRISM around scoped task tokens (staging is live and passing acceptance checks), and looking
        for remote senior engineering and architecture roles.
      </p>
    </div>
  </section>

  <section id="contact" class="section-shell container contact-section" aria-labelledby="contact-title">
    <div class="contact-panel">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Get in touch.</h2>
      <p>I’m available for senior software engineering, architecture, and technical leadership opportunities.</p>
      <a class="btn-primary" href="mailto:ryan@ryanguthrie.com">Email Ryan</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }

  .hero h1 {
    max-width: 900px;
    margin-top: 1rem;
    font-size: clamp(2.25rem, 4vw, 3.4rem);
    letter-spacing: -0.04em;
  }

  .hero-summary {
    max-width: 760px;
    margin-top: 1.75rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.75;
  }

  .hero-actions,
  .availability,
  .career-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-actions {
    gap: 0.85rem;
    margin-top: 2.1rem;
  }

  .hero-actions .text-link {
    margin-left: 0.4rem;
  }

  .availability {
    gap: 0.6rem 1.5rem;
    margin-top: 2.2rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .availability span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .availability span::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }







  .career-section {
    border-block: 1px solid var(--line);
    background: rgba(16, 25, 35, 0.46);
  }






  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .career-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 7vw, 6rem);
  }

  .career-grid h2,
  .contact-panel h2 {
    margin-top: 0.7rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.04em;
  }

  .now-section {
    border-top: 1px solid var(--line);
  }

  .now-section .container {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .now-copy {
    max-width: 900px;
    margin-top: 0.8rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.6;
    letter-spacing: -0.015em;
  }

  .now-copy a {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .career-copy > p {
    font-size: 1.08rem;
  }

  .career-actions {
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .contact-section {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .contact-panel {
    max-width: 900px;
  }

  .contact-panel p:not(.eyebrow) {
    margin-top: 1.25rem;
    font-size: 1.08rem;
  }

  .contact-panel .btn-primary {
    margin-top: 1.8rem;
  }

  @media (max-width: 900px) {




  }

  @media (max-width: 700px) {
    .projects-grid,
    .career-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding-block: 4rem 5rem;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .text-link {
      justify-content: center;
      margin: 0.3rem 0 0;
    }


  }
</style>
